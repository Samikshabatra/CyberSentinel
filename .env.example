# ---------------------------------------------------------------------------
# CyberSentinel environment configuration
# Copy to .env and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- LLM ---
# Base instruction model pulled from Hugging Face.
BASE_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
# Path to trained LoRA adapter. Leave empty to run the base model.
MODEL_ADAPTER_PATH=
# Backend: "mock" (no GPU/deps needed), "hf" (local transformers)
LLM_BACKEND=mock
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.2
LLM_LOAD_IN_4BIT=true
LLM_DEVICE=auto

# Hugging Face token (only needed for gated models)
HF_TOKEN=

# --- RAG / Vector store ---
# Port 6353, not Qdrant's default 6333, so this stack can run beside another
# project already using the default. Matches QDRANT_HOST_PORT in docker-compose.
QDRANT_URL=http://localhost:6353
QDRANT_API_KEY=
QDRANT_COLLECTION=cybersentinel_kb
# Set to true to use an in-memory Qdrant instance (tests / no Docker)
QDRANT_IN_MEMORY=false
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# Backend: "hash" (deterministic, dependency-free fallback), "sentence-transformers"
EMBEDDING_BACKEND=hash
TOP_K=5
# Hash embeddings score lower than a trained encoder; raise this (~0.25) when
# EMBEDDING_BACKEND=sentence-transformers.
RAG_SCORE_THRESHOLD=0.05

# --- Database ---
# SQLite default keeps the app runnable with zero services.
DATABASE_URL=sqlite:///./cybersentinel.db
# PostgreSQL example:
# PostgreSQL example (port 5433, not 5432, for the same reason as Qdrant above):
# DATABASE_URL=postgresql+psycopg://cybersentinel:cybersentinel@localhost:5433/cybersentinel

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
MAX_INPUT_CHARS=20000
MAX_UPLOAD_BYTES=1048576

# --- Human-in-the-loop ---
# Severity levels at or above this trigger analyst approval.
APPROVAL_SEVERITY_THRESHOLD=HIGH
